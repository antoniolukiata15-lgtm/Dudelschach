<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Dudelschach.MainPage">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="Purple" Offset="0.3" />
            <GradientStop Color="Red" Offset="1.1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="80"/>
            <Setter Property="BorderColor" Value="White"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="CornerRadius" Value="1"/>
        </Style> 
    </ContentPage.Resources>

    <Grid RowDefinitions="*, *, *, *" 
          ColumnDefinitions="*, *, *"
          RowSpacing="10"
          ColumnSpacing="10">
        
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
               Text="Dudelschach"/>

        <Button x:Name="button10" Grid.Row="1" Grid.Column="0" Clicked="Button_Clicked" />
        <Button x:Name="button11" Grid.Row="1" Grid.Column="01" Clicked="Button_Clicked" />
        <Button x:Name="button12" Grid.Row="1" Grid.Column="2" Clicked="Button_Clicked" />

        <Button x:Name="button20" Grid.Row="2" Grid.Column="0" Clicked="Button_Clicked" />
        <Button x:Name="button21" Grid.Row="2" Grid.Column="01" Clicked="Button_Clicked" />
        <Button x:Name="button22" Grid.Row="2" Grid.Column="2" Clicked="Button_Clicked" />

        <Button x:Name="button30" Grid.Row="3" Grid.Column="0" Clicked="Button_Clicked" />
        <Button x:Name="button31" Grid.Row="3" Grid.Column="01" Clicked="Button_Clicked" />
        <Button x:Name="button32" Grid.Row="3" Grid.Column="2" Clicked="Button_Clicked" />
    </Grid>
            
</ContentPage>
